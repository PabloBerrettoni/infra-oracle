# ---------------------------------------------------------------------------
# Copy this file to `.env`, fill in your real values, then `source .env`
# before running terraform commands. The real .env is gitignored.
# ---------------------------------------------------------------------------

# --- OCI provider credentials (API key auth) -------------------------------

# Tenancy OCID (Console → Profile → Tenancy)
export TF_VAR_tenancy_ocid="ocid1.tenancy.oc1..your-tenancy-ocid"

# IAM user OCID (Console → Profile → My profile → API keys)
export TF_VAR_user_ocid="ocid1.user.oc1..your-user-ocid"

# API key fingerprint (same screen as the user OCID)
export TF_VAR_fingerprint="aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"

# API signing key: EITHER its contents inline, OR a path to the PEM file.
export TF_VAR_private_key_path="~/.oci/oci_api_key.pem"
# export TF_VAR_private_key="-----BEGIN PRIVATE KEY-----
# ...key contents...
# -----END PRIVATE KEY-----"

# Your home region (image OCID defaults are pinned to sa-saopaulo-1; override
# image_ocid on each compute module call with an OCID from your region).
export TF_VAR_region="sa-saopaulo-1"

# --- SSH keys installed on every VM ----------------------------------------
# JSON array; the user field is informational, the publickey is what matters.
export TF_VAR_ssh_public_keys='[{"user":"ubuntu","publickey":"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@host"}]'
